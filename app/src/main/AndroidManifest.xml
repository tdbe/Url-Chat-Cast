<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- universal phone + TV -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- From Android 10+ this permission also exempts us from background-activity-start limits. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="A notification event responder for casting URLs when a certain command is present." />
    <!-- The specialUse is the Type of foreground service we use. It's a catch-all designation in Android 14 and higher for valid long-running foreground tasks that do not fit into any of the standard types (such as location, mediaPlayback, camera, or dataSync)-->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:ignore="A notification event responder for casting URLs when a certain command is present." />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:label="Url Chat Cast"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.UrlChatCast"
        android:allowBackup="true">

        <service
            android:name=".Listener"
            android:label="Url Chat Cast"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A notification event responder for casting URLs when a certain command is present." />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PopupActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.UrlChatCast.Popup" />
    </application>
</manifest>